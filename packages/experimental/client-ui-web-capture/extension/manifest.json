{
  "manifest_version": 3,
  "name": "DSH Web Capture",
  "version": "0.1.0",
  "description": "一键把当前网页快照成 PDF，送进 DeepSeek Harness 的 PDF 阅读器（需已安装 web-capture 插件并打开 DSH GUI）。",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH 网页快照"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content-gui.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
